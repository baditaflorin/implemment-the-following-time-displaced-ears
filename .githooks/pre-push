#!/usr/bin/env bash
zero="0000000000000000000000000000000000000000"
_skip_full=true
while read -r _local_ref _local_oid _remote_ref _remote_oid; do
  if [ "$_remote_oid" = "$zero" ] || [ "$_local_oid" = "$zero" ]; then
    _skip_full=false
    continue
  fi
  _changed="$(git diff --name-only "$_remote_oid" "$_local_oid" 2>/dev/null || true)"
  if [ -n "$_changed" ] && printf '%s\n' "$_changed" | grep -qvE '^(CLAUDE\.md|\.githooks/.*)$'; then
    _skip_full=false
  fi
done
if [ "$_skip_full" = true ]; then
  exit 0
fi
# pre-push: tests, build, verify docs/ is Pages-ready, smoke.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ ! -d node_modules ]; then
  echo "[pre-push] node_modules missing — run 'npm install'"
  exit 1
fi

echo "[pre-push] unit tests"
npm test

echo "[pre-push] build"
npm run build

if [ ! -s docs/index.html ]; then
  echo "[pre-push] FATAL: docs/index.html missing or empty"
  exit 1
fi
if [ ! -f docs/.nojekyll ]; then
  echo "[pre-push] FATAL: docs/.nojekyll missing"
  exit 1
fi

echo "[pre-push] smoke"
npm run smoke

echo "[pre-push] ok"
